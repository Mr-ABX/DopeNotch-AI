{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DopeNotch AI",
  "version": "0.4.0",
  "identifier": "com.dopenotch.ai",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "tray",
        "title": "DopeNotch Menu",
        "url": "/",
        "width": 300,
        "height": 450,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": false,
        "focus": true
      },
      {
        "label": "settings",
        "title": "DopeNotch Dashboard",
        "url": "/",
        "width": 960,
        "height": 700,
        "resizable": true,
        "decorations": true,
        "titleBarStyle": "Transparent",
        "transparent": true,
        "visible": false,
        "center": true
      },
      {
        "label": "notch",
        "title": "DopeNotch Shelf",
        "url": "/",
        "width": 160,
        "height": 28,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": false,
        "focus": true
      },
      {
        "label": "ruler",
        "title": "DopeNotch Pixel Ruler",
        "url": "/",
        "width": 1920,
        "height": 1080,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": false,
        "focus": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "macOS": {
      "entitlements": "entitlements.plist",
      "infoPlist": "Info.plist",
      "signingIdentity": null
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "wix": {
        "language": "en-US"
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
